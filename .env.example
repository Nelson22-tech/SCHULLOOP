# Environment Variables Template
#
# Only EXPO_PUBLIC_-prefixed values belong here: they are compiled into
# the client app bundle and are publicly readable. Secret/private keys
# (Flutterwave secret key, Flutterwave encryption key, Firebase admin
# credentials, etc.) must instead live in backend/.env and never be
# prefixed EXPO_PUBLIC_.

# Firebase Configuration (public, safe client-side)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Flutterwave Payment (public key only - see backend/.env.example for the secret/encryption keys)
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Environment
NODE_ENV=development

# Social sign-in (public client IDs). See SOCIAL_SIGNIN_SETUP.md
EXPO_PUBLIC_APPLE_CLIENT_ID=your.apple.services.id
