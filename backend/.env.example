PORT=5000
MONGO_URI=mongodb://localhost:27017/schulloop
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Optional HTTPS callback; the mobile app supplies a deep-link return URL for checkout.
FLUTTERWAVE_REDIRECT_URL=
SEED_SAMPLE_DATA=false

# Social sign-in. Comma-separate multiple client IDs if needed.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Allowed app return-URL prefixes for the Apple callback (defaults cover Expo/dev).
APP_RETURN_URL_PREFIXES=schulloop://,exp://,http://localhost,https://localhost

# Share of each school-fee payment kept by the platform, in percent (0-20).
PLATFORM_FEE_PERCENT=3

# Share of each mentor lesson price kept by the platform, in percent (0-40).
MENTOR_COMMISSION_PERCENT=15

# Set to 1 when the backend runs behind a hosting proxy (Render, Railway, etc.) so rate limits see real client IPs
TRUST_PROXY=

# Email (needed for password-reset codes). Pick ONE provider.
# Brevo (free 300 emails/day, only needs a verified sender email): https://www.brevo.com -> SMTP & API -> API keys
BREVO_API_KEY=
# Resend (free tier, needs a verified domain to email anyone): https://resend.com
RESEND_API_KEY=
# The "from" address. For Brevo it must be a sender you verified in Brevo.
MAIL_FROM=
MAIL_FROM_NAME=SchulLoop
