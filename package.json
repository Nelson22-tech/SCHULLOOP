{
  "name": "globalschoolfinder",
  "main": "node_modules/expo/AppEntry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:dev:android": "npx eas-cli build --platform android --profile development",
    "build:dev:ios": "npx eas-cli build --platform ios --profile development",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "upgrade": "expo install --fix && expo-doctor",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.0",
    "@react-navigation/elements": "^1.3.7",
    "@react-navigation/native": "^6.1.8",
    "@react-navigation/native-stack": "^6.6.0",
    "axios": "^1.7.2",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "^25.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.0.1",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "^5.6.2",
